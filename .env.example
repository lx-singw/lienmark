# ── Google Cloud ──────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=lienmark-dev-lx-2026
GOOGLE_CLOUD_REGION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=./secrets/service-account.json

# ── Gemini / Agent Builder ────────────────────────────────────
GEMINI_MODEL=gemini-2.5-pro
GEMINI_FLASH_MODEL=gemini-2.5-flash
GEMINI_FLASH_LITE_MODEL=gemini-2.5-flash-lite
AGENT_BUILDER_PROJECT_ID=lienmark-dev-lx-2026
AGENT_BUILDER_LOCATION=us-central1

# ── Parallel & MCP ─────────────────────────────────────────────
PARALLEL_API_KEY=your-parallel-api-key-here
PARALLEL_SEARCH_API_BASE_URL=https://api.parallel.ai
PARALLEL_MCP_SERVER_URL=https://search.parallel.ai/mcp

# ── Firestore ──────────────────────────────────────────────────
FIRESTORE_PROJECT_ID=lienmark-dev-lx-2026
FIRESTORE_DATABASE=(default)

# ── App & Governance Config ────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=info
DEMO_MODE=true
MAX_API_SPEND_USD=10.00
MAX_PIPELINE_LATENCY_SECONDS=15
GCS_WATCH_BUCKET=gs://studio-locked-drafts/
SIR_DEDUCTIBLE_USD=25000.0
VERIFICATION_TTL_DAYS=30

# ── Frontend & Internal Routing ───────────────────────────────
INTERNAL_API_URL=http://backend:8080
BACKEND_URL=http://backend:8080
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_ENVIRONMENT=development

# ── Human-in-the-loop threshold ───────────────────────────────
RISK_CONFIDENCE_THRESHOLD=0.7
