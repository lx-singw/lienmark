rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if request is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // productions collection: studio / production metadata
    match /productions/{productionId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if false;
    }

    // claims collection: extracted rights claims from Intake Agent
    match /claims/{claimId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if false;
    }

    // research_findings collection: live Parallel Search API search results
    match /research_findings/{findingId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if false;
    }

    // ledger_entries collection: THE IMMUTABLE AUDIT LOG
    // Strictly CREATE-ONLY. No updates or deletions allowed under any circumstances.
    // Backward pointers (supersedes_entry_id) are used for versioning.
    match /ledger_entries/{entryId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    // risk_scores collection: deterministic rule engine output
    match /risk_scores/{scoreId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if false;
    }

    // reports collection: compiled clearance reports & E&O certificates
    match /reports/{reportId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if false;
    }

    // agent_state_store collection: background poller checkpoints & heartbeats
    match /agent_state_store/{stateId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if false;
    }
  }
}
