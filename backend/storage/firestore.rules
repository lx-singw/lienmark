rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for authentication and tenant isolation
    function isAuthenticated() {
      return request.auth != null;
    }

    function isTenantMember(orgId) {
      return isAuthenticated() && (
        request.auth.token.organization_id == orgId ||
        request.auth.token.org_id == orgId ||
        (request.auth.token.is_demo == true && (orgId == "org_demo" || orgId == "org_studio_alpha"))
      );
    }

    function isReviewerOrAdmin(orgId) {
      return isTenantMember(orgId) && (
        "Reviewer" in request.auth.token.roles ||
        "Admin" in request.auth.token.roles ||
        request.auth.token.is_counsel == true
      );
    }

    // ─── Sprint 1.1 Multi-Tenant Canonical Hierarchy ─────────────────────────
    // /organizations/{orgId}
    match /organizations/{orgId} {
      allow read: if isTenantMember(orgId);
      allow write: if isTenantMember(orgId);

      // Productions subcollection
      match /productions/{productionId} {
        allow read: if isTenantMember(orgId);
        allow create, update: if isTenantMember(orgId);
        allow delete: if isReviewerOrAdmin(orgId);

        // Production versions
        match /versions/{versionId} {
          allow read: if isTenantMember(orgId);
          allow create, update: if isTenantMember(orgId);
          allow delete: if false;
        }

        // Runs subcollection
        match /runs/{runId} {
          allow read: if isTenantMember(orgId);
          allow create, update: if isTenantMember(orgId);
          allow delete: if false;

          // Claims subcollection
          match /claims/{claimKey} {
            allow read: if isTenantMember(orgId);
            allow write: if isTenantMember(orgId);
          }

          // Decisions subcollection (Requires Reviewer or Admin for approval/override)
          match /decisions/{decisionKey} {
            allow read: if isTenantMember(orgId);
            allow write: if isReviewerOrAdmin(orgId);
          }

          // Research findings subcollection
          match /research_findings/{findingId} {
            allow read: if isTenantMember(orgId);
            allow write: if isTenantMember(orgId);
          }

          // Cryptographic Audit Trail: STRICTLY CREATE-ONLY (append-only)
          match /audit_events/{eventId} {
            allow read: if isTenantMember(orgId);
            allow create: if isTenantMember(orgId);
            allow update, delete: if false;
          }

          // Atomic sequencer counter
          match /counters/{counterId} {
            allow read: if isTenantMember(orgId);
            allow write: if isTenantMember(orgId);
          }

          // Reports & Schedules
          match /reports/{reportId} {
            allow read: if isTenantMember(orgId);
            allow write: if isTenantMember(orgId);
          }
        }
      }

      // Ingested Documents
      match /documents/{docId} {
        allow read: if isTenantMember(orgId);
        allow create, update: if isTenantMember(orgId);
        allow delete: if isReviewerOrAdmin(orgId);
      }
    }

    // ─── Legacy Session Compatibility Pointers ───────────────────────────────
    match /sessions/{sessionId} {
      allow read, write: if true;
      match /runs/{runId} {
        allow read, write: if true;
      }
    }

    // Persistent usage counters
    match /usage_counters/{environment} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}
